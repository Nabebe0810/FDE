   {
    "v": "total",
    "label": "使う人はもっと多い",
    "set": {
     "NFR.users_total": "101〜1000人"
    }
   },
   {
    "v": "conc",
    "label": "同時に使うのはもっと少ない",
    "set": {
     "NFR.concurrency": "1〜5人"
    }
   },
   {
    "v": "both",
    "label": "場合によって違う"
   }
  ],
  "decides": [
