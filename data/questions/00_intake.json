  "deepdive": [
   "solutionOnly",
   "abstract"
  ],
  "copyTo": [
   {
    "det": "solutionOnly",
    "slot": "BR.means"
   }
  ],
  "patterns": [
   "困りごとが書かれている → 困りごとの種類へ",
   "手段（アプリ・自動化など）だけ → 元の困りごとを聞く",
   "短い・抽象的 → 最近の一件を聞く"
  ],
  "hypothesis": "相談の中に、困りごと・原因・期待する成果・手段が混ざっている",
  "falsifier": "困りごとと成果が具体的に書かれていれば、手段の深掘りは不要",
  "outputs": [
   "BR.problem",
   "BR.means"
  ],
  "importance": 5,
  "mandatory": true,
  "costSec": 120,
  "sources": [
   "C:VS1",
   "C:原則4",
   "A:04_発想の問い",
   "zip:Q-PRJ-001"
  ]
 },
