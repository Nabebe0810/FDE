[
 {
  "id": "Q-INT-001",
  "order": 1,
  "phase": "00_受付",
  "step": 1,
  "topic": "core",
  "persona": "全員",
  "text": "今回、どんなことを相談したいですか？思いつくまま書いてください。",
  "help": "うまくまとめなくて大丈夫です。例：「申込の受付を電話でしていて、聞き間違いが多い」",
  "intent": "相談の原文を得る（以後の分類・深掘りの起点。原文は書き換えない）",
  "technique": "契約の問い",
  "decides": [
   "以後の深掘りの方向（困りごと／手段／成果）"
  ],
  "slot": "PRJ.request_raw",
  "input": {
   "type": "longtext",
   "placeholder": "自由に書いてください",
   "minChars": 0
